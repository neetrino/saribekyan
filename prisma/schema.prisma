generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model NewsPost {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  excerpt     String
  category    String
  coverImage  String
  publishedAt DateTime
  featured    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([publishedAt(sort: Desc)])
  @@index([featured])
}

model Partner {
  id        String   @id @default(cuid())
  name      String
  logoUrl   String
  website   String?
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sortOrder])
}

model StatSnapshot {
  id        String   @id @default(cuid())
  year      Int
  value     Int
  label     String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([year, label])
  @@index([sortOrder])
}

model Program {
  id          String   @id @default(cuid())
  slug        String   @unique
  number      String
  title       String
  description String
  imageUrl    String
  href        String
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([sortOrder])
}

model Clinic {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  description String
  imageUrl    String
  href        String
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([sortOrder])
}

model AdmissionStep {
  id          String   @id @default(cuid())
  number      String
  title       String
  description String
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([sortOrder])
}

/// Single source of truth for university staff. Where a member appears on the
/// site is defined by `TeamMemberPlacement` rows (page + section + order).
model TeamMember {
  id         String                @id @default(cuid())
  nameHy     String
  nameEn     String
  positionHy String
  positionEn String
  bioHy      String?
  bioEn      String?
  photoUrl   String?
  email      String?
  phone      String?
  createdAt  DateTime              @default(now())
  updatedAt  DateTime              @updatedAt
  placements TeamMemberPlacement[]

  @@index([nameHy])
  @@index([nameEn])
}

/// `pageKey` / `sectionKey` are validated against the code registry in
/// `src/features/team/config/placements.ts`.
model TeamMemberPlacement {
  id         String     @id @default(cuid())
  memberId   String
  member     TeamMember @relation(fields: [memberId], references: [id], onDelete: Cascade)
  pageKey    String
  sectionKey String
  sortOrder  Int        @default(0)
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  @@unique([memberId, pageKey, sectionKey])
  @@index([pageKey, sectionKey, sortOrder])
}

/// Single library of downloadable PDF documents. Where a document appears on the site
/// is defined by `SiteDocumentPlacement` rows (page + section + order).
model SiteDocument {
  id            String                  @id @default(cuid())
  titleHy       String
  titleEn       String
  descriptionHy String?
  descriptionEn String?
  year          Int
  fileUrl       String
  fileName      String
  fileSize      Int
  createdAt     DateTime                @default(now())
  updatedAt     DateTime                @updatedAt
  placements    SiteDocumentPlacement[]

  @@index([year])
  @@index([titleHy])
}

/// `pageKey` / `sectionKey` are validated against the code registry in
/// `src/features/documents/config/placements.ts`.
model SiteDocumentPlacement {
  id         String       @id @default(cuid())
  documentId String
  document   SiteDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  pageKey    String
  sectionKey String
  sortOrder  Int          @default(0)
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  @@unique([documentId, pageKey, sectionKey])
  @@index([pageKey, sectionKey, sortOrder])
}

model SiteSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt
}
